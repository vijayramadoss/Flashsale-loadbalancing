# Copy to .env (next to docker-compose.yml) and replace every value. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret
REDIS_PASSWORD=replace-with-a-random-password
ADMIN_EMAIL=admin@flashsale.test
ADMIN_PASSWORD=replace-with-a-strong-admin-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-grafana-password
# Optional: require "Authorization: Bearer <token>" on /metrics (Prometheus config must match)
METRICS_TOKEN=
# Host ports (change if something else already uses them). CDN_URL must match CDN_PORT.
WEB_PORT=8080
CDN_PORT=8081
CDN_URL=http://localhost:8081
GRAFANA_PORT=3000
