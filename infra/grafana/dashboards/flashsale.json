{
  "uid": "flashsale",
  "title": "FlashSale — traffic, latency, queue",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / s by replica (load balancing)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (replica) (rate(flashsale_http_requests_total[30s]))", "legendFormat": "{{replica}}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by route (server-side)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(flashsale_http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Flash-deal queue (Redis Streams)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(flashsale_queue_backlog)", "legendFormat": "backlog" },
        { "refId": "B", "expr": "max(flashsale_queue_pending)", "legendFormat": "in flight" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Responses by status code",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(flashsale_http_requests_total[30s]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event-loop delay p99 by replica",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "flashsale_event_loop_delay_seconds{quantile=\"0.99\"}", "legendFormat": "{{replica}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory (RSS) by replica",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "{{replica}}" }]
    }
  ]
}
