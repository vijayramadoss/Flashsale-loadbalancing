# Copy to backend/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000

# MongoDB must be a replica set (transactions). A single-node set is fine locally.
MONGO_URI=mongodb://127.0.0.1:27018/flashsale?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=fs:

# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# Number of reverse proxies in front of the API (1 behind NGINX). 0 when exposed directly.
TRUST_PROXY=0

# Rate limits (fixed window, per RATE_LIMIT_WINDOW_SEC seconds)
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_IP_MAX=60
RATE_LIMIT_CHECKOUT_USER_MAX=5
RATE_LIMIT_AUTH_IP_MAX=20

# Order worker
WORKER_BATCH_SIZE=50
WORKER_BLOCK_MS=2000
WORKER_MAX_DELIVERIES=5
WORKER_CLAIM_IDLE_MS=30000

# API processes started by `npm run start:cluster` (0 = one per CPU core)
WEB_CONCURRENCY=0
# Serve frontend/dist from the API (single-origin deployment)
SERVE_FRONTEND=false

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@flashsale.test
ADMIN_PASSWORD=choose-a-strong-admin-password
