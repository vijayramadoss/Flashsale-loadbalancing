# Test-only settings (no real secrets). Uses a separate database and Redis DB/prefix.
NODE_ENV=test
MONGO_URI=mongodb://127.0.0.1:27018/flashsale_test?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_PREFIX=fstest:
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789
BCRYPT_ROUNDS=4
TRUST_PROXY=loopback
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_IP_MAX=100000
RATE_LIMIT_CHECKOUT_USER_MAX=5
RATE_LIMIT_AUTH_IP_MAX=100000
WORKER_BLOCK_MS=100
