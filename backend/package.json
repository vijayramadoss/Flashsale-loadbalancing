{
  "name": "flashsale-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:cluster": "node --env-file-if-exists=.env src/cluster.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "init-replset": "node --env-file-if-exists=.env scripts/init-replset.js",
    "loadtest": "node --env-file=.env --env-file=.env.loadtest scripts/loadtest.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/*.test.js\"",
    "start:loadtest": "node --env-file=.env --env-file=.env.loadtest src/cluster.js",
    "worker:loadtest": "node --env-file=.env --env-file=.env.loadtest src/worker.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "supertest": "^7.3.1"
  }
}
