# Overrides layered on top of .env for load testing (no secrets here).
# Isolated database and Redis namespace so dev data is untouched.
MONGO_URI=mongodb://127.0.0.1:27018/flashsale_load?replicaSet=rs0
REDIS_PREFIX=fsload:
PORT=4100
# The load generator simulates many client IPs via X-Forwarded-For, as NGINX would.
TRUST_PROXY=1
