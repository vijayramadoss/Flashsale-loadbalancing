# Overrides for the load-balancer demo / 10,000-user simulation (no secrets here).
# Isolated database + Redis namespace; three replicas are started on ports 4001-4003.
MONGO_URI=mongodb://127.0.0.1:27018/flashsale_sim?replicaSet=rs0
REDIS_PREFIX=fssim:
# NGINX runs on this machine and appends to X-Forwarded-For.
TRUST_PROXY=loopback
# A simulated shopper polls and retries a lot; keep the per-IP API budget realistic but not tight.
RATE_LIMIT_IP_MAX=120

# Gateway webhooks go through the load balancer, like a real gateway calling your public URL.
PAYMENT_WEBHOOK_URL=http://127.0.0.1:8088/api/webhooks/gateway
